            "external_message_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "author_claim": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "id",
            "content_text",
            "source_kind"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "email_text"
