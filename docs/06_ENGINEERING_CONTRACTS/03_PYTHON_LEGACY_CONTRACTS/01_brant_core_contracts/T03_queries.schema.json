  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "positive_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[^0-9a-f]"
      }
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "maxLength": 27,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "not": {
        "pattern": "[^0-9T:Z.\\-]"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "note": {
      "type": "string",
      "maxLength": 5000
    },
    "quantity": {
      "type": "string",
      "maxLength": 26,
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$",
      "not": {
        "pattern": "[^0-9.]"
      }
    },
    "price": {
      "type": "string",
      "maxLength": 26,
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
      "not": {
        "pattern": "[^0-9.]"
      }
    },
    "ratio": {
      "type": "string",
      "maxLength": 26,
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
      "not": {
        "pattern": "[^0-9.]"
      }
    },
    "minor": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^(?:0|[1-9][0-9]{0,23})$",
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "signed_minor": {
      "type": "string",
      "maxLength": 25,
      "pattern": "^(?:0|-?[1-9][0-9]{0,23})$",
      "not": {
        "pattern": "[^0-9-]"
      }
