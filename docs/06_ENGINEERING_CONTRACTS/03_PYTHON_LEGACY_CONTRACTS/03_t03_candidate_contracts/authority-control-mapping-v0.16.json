{
  "version": "0.16",
  "status": "runtime_slice",
  "scope": "trusted local T03 quote and approval read adapter",
  "contract": "brant.quotation/0.1.0",
  "query_actions": {
    "quote.query.quote_root": {
      "permission": ["quote.read"],
      "human_only": false,
      "task_control": false
    },
    "quote.query.quote_ready": {
      "permission": ["quote.read", "costing.read", "read", "foundation.read"],
      "human_only": false,
      "task_control": false
    },
    "quote.query.quote_history": {
      "permission": ["quote.read", "costing.read", "read", "foundation.read"],
      "human_only": false,
      "task_control": false,
      "revision_selector": "business_revision is required",
      "response": "compact metadata and qualification summary; no raw internal payload"
    },
    "quote.query.approval_history": {
      "permission": ["quote.read"],
      "human_only": false,
      "task_control": false,
      "selector": "approval_id is required",
      "response": "approval/effectivity metadata and payload-free event summary"
    }
  },
  "unregistered_query_kinds": ["quote_revision", "approval", "document"],
  "unimplemented": [
    "external quote write command contract",
    "enterprise identity provider mapping",
    "production document storage",
    "send/delivery/customer acceptance",
    "order conversion",
    "commit-unknown reconciliation"
  ]
}
