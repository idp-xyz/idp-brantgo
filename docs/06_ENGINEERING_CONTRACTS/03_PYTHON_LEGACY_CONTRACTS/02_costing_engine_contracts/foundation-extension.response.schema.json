{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "kind": {
          "const": "foundation_extension_ack"
        },
        "object_ref": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "location",
                "pricing_policy",
                "delivery_calendar",
                "trade_scope",
                "tax_application"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "not": {
                "pattern": "[^A-Za-z0-9._:-]"
              }
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "root_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "active_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "working_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "active_with_draft",
            "retired",
            "empty"
          ]
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "kind",
        "object_ref",
        "root_version",
        "status",
        "replayed"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "field_errors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ok",
        "code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "PERMISSION_DENIED",
                  "NOT_FOUND"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "field_errors"
              ]
            }
          }
        }
      ]
    }
  ]
}
