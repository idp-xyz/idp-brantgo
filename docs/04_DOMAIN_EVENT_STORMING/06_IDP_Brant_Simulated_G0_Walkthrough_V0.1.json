  "findings": [
    {
      "id": "F-01",
      "kind": "GAP",
      "title": "同一报价多次下单（返单）被整单一次转换阻断",
      "decision": "BC-D06 裁决：P0 保留 full_v1；R1 增加参照报价下单（部分与多次），以报价行剩余数量台账控制，每张订单独立确认与审批；P0 期间返单以复制原报价形成新报价根并重新审批。",
      "owner": "R-PRD",
      "wbs": "S6-07",
      "refs": "BC-D06；SAP 流程参照 O2C-04"
    },
    {
      "id": "F-02",
      "kind": "GAP",
      "title": "合同适用法律与争议解决条款未建模",
      "decision": "报价与外销合同条款增加适用法律与争议解决（POL 条款模板），合同成立规则按适用法律选择；默认 CISG 与中国法，由租户配置。",
      "owner": "R-TRD",
      "wbs": "S3-17",
      "refs": "ADR-BR-013"
    },
    {
      "id": "F-03",
      "kind": "GAP",
      "title": "CIF／CIP 投保与保险单未建模",
      "decision": "FUL 出运单证套增加保险单引用（保险服务方、投保金额、险别、保单号）；投保金额与险别按合同（CIF 通常按 CIF 价 110%）；保险费已是核价组件。",
      "owner": "R-FUL",
      "wbs": "S5-16",
      "refs": "补齐矩阵 INT-03／04"
    },
    {
      "id": "F-04",
      "kind": "DECISION",
      "title": "见提单副本付款且控制正本提单或电放时的信用口径",
      "decision": "信用政策可把单证控制下的出运后付款视为有担保，不需信用占用；前提是 FUL 放行闸门把单证扣到付款为止。TRD-INV-022 已按此修订。",
      "owner": "R-STL",
      "wbs": "S5-12",
      "refs": "TRD-INV-022；FUL-INV-002"
    },
    {
      "id": "F-05",
      "kind": "PARTIAL",
      "title": "客诉、折让与贷项只到轮廓",
